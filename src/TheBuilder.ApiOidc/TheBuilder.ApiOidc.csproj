<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>TheBuilder.ApiOidc</PackageId>
    <Product>OIDC for Umbraco APIs</Product>
    <Title>OIDC workload tokens for the Umbraco Delivery API and custom APIs</Title>
    <!-- The local fallback. A release sets the version from its tag; see RELEASE.md. -->
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>Let Vercel, GitHub Actions and other workloads call the Umbraco Delivery API and your own API endpoints with their OIDC token instead of a shared API key.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;delivery-api;oidc;vercel;github-actions;workload-identity;headless</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-api-oidc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-api-oidc.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/thebuilder/umbraco-api-oidc/releases for release notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" VersionOverride="$(UmbracoVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <!-- Security floors for dependencies inherited from the supported Umbraco range. -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheBuilder.ApiOidc.Tests" />
  </ItemGroup>
</Project>
