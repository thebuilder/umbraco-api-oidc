---
// @ts-nocheck - Blume's React island types flag valid Astro attributes.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { loadUmbracoPackages } from "@thebuilder/umbraco-docs";
import { EcosystemSection, InstallCommand, LandingHero, LandingRoot } from "@thebuilder/umbraco-docs/astro";
import HeroParticles from "@thebuilder/umbraco-docs/components/HeroParticles";

import "./_home/home.css";

import { apiOidcPackage } from "../umbraco-package";

// The other packages come from the hub at umbraco.thebuilder.dk, so this list never needs editing here.
const ecosystemPackages = await loadUmbracoPackages();

const { config } = data;
const installCommand = "dotnet add package TheBuilder.ApiOidc";
const repoUrl = apiOidcPackage.links.github;
const configExample = `"ApiOidc": {
  "Issuers": [
    { "Preset": "Vercel", "Team": "acme" }
  ]
}`;
const fetchExample = `import { getVercelOidcToken } from "@vercel/oidc";

const url = new URL("/umbraco/delivery/api/v2/content", UMBRACO_URL);
const response = await fetch(url, {
  headers: { "X-Oidc-Token": await getVercelOidcToken() },
});`;

const features = [
  {
    title: "Nothing to rotate",
    body: "Each token is signed by the platform and expires on its own. There is no key to copy into each project's environment variables.",
  },
  {
    title: "You list who gets in",
    body: "A Vercel team, a set of GitHub repositories or a cloud service account. Tokens from anywhere else are refused.",
  },
  {
    title: "The API key still works",
    body: "Public access and the API key behave as before, so you can move frontends over one at a time.",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og/index.png"
  page={{
    title: "API OIDC for Umbraco",
    description: config.description,
    route: "/",
  }}
>
  <LandingRoot class="home">
    <LandingHero
      eyebrow="Workload identity for the Umbraco Delivery API"
      title="Your platform's token,"
      accent="instead of a shared API key."
      description="Vercel, GitHub Actions, Google Cloud, AWS and GitLab give each workload a short-lived, signed token. Umbraco accepts it on the Delivery API and on the endpoints you choose."
      compatibility="Umbraco CMS 17.1 or later · .NET 10"
    >
      <HeroParticles slot="background" logo="/logo-mark.svg" />
      <Fragment slot="actions">
        <a class="button button--primary" href="/quickstart">Get started</a>
        <a class="button button--secondary" href={repoUrl} rel="noopener">View on GitHub</a>
      </Fragment>
      <InstallCommand slot="install" command={installCommand} />
    </LandingHero>

    <section class="shell trust reveal">
      <p><strong>A token only adds a way in.</strong> A request without one, or with a refused one, gets the same answer from Umbraco as it does today.</p>
    </section>

    <section class="shell section" aria-labelledby="features-title">
      <div class="section-heading reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2 id="features-title">Why use a token instead of the key</h2>
        <p>For frontends that run on Vercel, GitHub Actions, Google Cloud, AWS, GitLab or another platform that issues OIDC tokens.</p>
      </div>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article class="feature-card reveal" style={`--i: ${index + 1}`}>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="shell flow" aria-labelledby="flow-title">
      <div class="flow__copy reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2 id="flow-title">Trust an issuer in appsettings</h2>
        <p>Presets cover Vercel and GitHub Actions. Any other OIDC issuer needs its URL, an audience and the claims a token must carry.</p>
        <a class="text-link" href="/issuers">Set up your issuer <span aria-hidden="true">→</span></a>
      </div>
      <figure class="code-preview reveal" style="--i: 1">
        <figcaption>appsettings.json <span>JSON</span></figcaption>
        <pre tabindex="0"><code>{configExample}</code></pre>
      </figure>
    </section>

    <section class="shell api" aria-labelledby="api-title">
      <div class="api__copy reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2 id="api-title">Send the token in a header</h2>
        <p>The frontend asks its platform for a token and sends it as <code>X-Oidc-Token</code>. Your own endpoints can require the same token with an attribute.</p>
        <a class="button button--secondary" href="/custom-endpoints">Protect your own endpoints</a>
      </div>
      <figure class="code-preview reveal" style="--i: 1">
        <figcaption>A Vercel function <span>TypeScript</span></figcaption>
        <pre tabindex="0"><code>{fetchExample}</code></pre>
      </figure>
    </section>

    <section class="shell closing reveal">
      <h2>Try it on one frontend</h2>
      <p>Install the package, add your platform's issuer, and send the token from one frontend. The others keep using the API key until you move them.</p>
      <a class="button button--primary" href="/quickstart">Read the quickstart</a>
    </section>

    <EcosystemSection
      packages={ecosystemPackages}
      currentPackageId={apiOidcPackage.id}
    />
  </LandingRoot>

  <footer class="home-footer" slot="footer">
    <div class="shell home-footer__inner">
      <div>
        <strong>API OIDC</strong>
        <span>MIT licensed · built by <a href="https://github.com/thebuilder" rel="noopener">thebuilder</a></span>
      </div>
      <nav aria-label="Footer">
        <a href="/overview">Docs</a>
        <a href={repoUrl} rel="noopener">GitHub</a>
      </nav>
    </div>
  </footer>
</PageLayout>
